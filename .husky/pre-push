set -e

echo "🚀 Running pre-push validation..."

echo "📝 Checking types..."
if ! pnpm check-types; then
  echo "❌ TypeScript type check failed. Please check the output above and fix type errors."
  exit 1
fi

echo "🏗️  Building packages..."
if ! pnpm build; then
  echo "❌ Build failed. Please check the output above and fix build errors."
  exit 1
fi

echo "✅ All pre-push checks passed! Safe to push."
