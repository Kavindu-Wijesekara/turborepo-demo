set -e

echo "🎨 Formatting staged files..."
if ! pnpm exec lint-staged; then
  echo "❌ Prettier formatting failed. Please check the output above."
  exit 1
fi

echo "🔍 Running linters..."
if ! pnpm lint:fix; then
  echo "❌ ESLint found issues. Please check the output above and fix them."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
