# ===================================
# DATABASE CONFIGURATION
# ===================================
# Connection string with connection pooling (Supabase Transaction mode)
# Used by application code for database queries
# Get from: Supabase Dashboard → Project Settings → Database → Connection String (Transaction mode)
DATABASE_URL="postgresql://user:password@localhost:5432/monorepo"

# Direct connection string without pooling (Supabase Session mode)
# Required for running migrations and administrative tasks
# Get from: Supabase Dashboard → Project Settings → Database → Connection String (Session mode)
DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/monorepo"

# ===================================
# CLERK AUTHENTICATION (Admin App)
# ===================================
# Get these from: https://dashboard.clerk.com → API Keys
# Server-side secret key - never expose to client
CLERK_SECRET_KEY="sk_test_..."
# Client-side publishable key - safe to expose
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# ===================================
# SUPABASE CONFIGURATION (Client App)
# ===================================
# Get these from: https://app.supabase.com/project/_/settings/api
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Publishable key (new format: sb_publishable_xxx) - safe to expose to browser
# Replaces the legacy anon key. Get from: API Keys tab → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ===================================
# CLOUDFLARE TURNSTILE (Client App)
# ===================================
# Get these from: https://dash.cloudflare.com → Turnstile
# Client-side site key - safe to expose to browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAA..."
# Server-side secret key - never expose to client (configure in Supabase Dashboard)
# Navigate to: Auth → Settings → Bot and Abuse Protection → Enable CAPTCHA protection
# Note: Secret key is NOT stored in environment variables, it's configured in Supabase Dashboard

# ===================================
# APPLICATION CONFIGURATION
# ===================================
# Base URL for the application (used for OAuth callbacks and redirects)
# Local development (both apps):
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (update per app):
# Admin app: NEXT_PUBLIC_APP_URL="https://admin.yourdomain.com"
# Client app: NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"

# ===================================
# RUNTIME ENVIRONMENT
# ===================================
# Automatically set by Next.js and Vercel
# Can override for testing: "development" | "test" | "production"
# NODE_ENV="development"
